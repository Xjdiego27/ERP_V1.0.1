# ═══════════════════════════════════════════════════════════
# .env — Variables de entorno para Docker Compose
# 📋 Copiar este archivo a .env y configurar TODOS los valores
# ⚠️  NUNCA subir .env a Git (ya está en .gitignore)
# ═══════════════════════════════════════════════════════════

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MySQL 8 — Base de datos principal
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Password de root (solo para administración)
MYSQL_ROOT_PASSWORD=R00t_ERP_2026!SecurE

# Usuario de aplicación (el backend usa este)
DB_USER=erp_app
DB_PASSWORD=ErP_App_P@ssw0rd_2026
DB_NAME=erp

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MongoDB 7 — Base de datos NoSQL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MONGO_USER=erp_mongo_admin
MONGO_PASSWORD=M0ng0_ERP_2026!SecurE
MONGO_DB_NAME=erp_nosql

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# JWT — Autenticación
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Genera una llave segura: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CAMBIA_ESTA_LLAVE_genera_con_secrets_token_urlsafe_64
ALGORITHM=HS256
TOKEN_EXPIRE=480

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# CORS — Orígenes permitidos (separar con coma)
# Incluir la IP/dominio del servidor
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CORS_ORIGINS=http://localhost,http://localhost:80,http://TU_IP_SERVIDOR

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Puertos del host (cambiar si hay conflicto)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
API_PORT=8000
FRONTEND_PORT=80

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# URLs para el build del Frontend (Vite)
# En producción se resuelven dinámicamente
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VITE_API_URL=http://localhost:8000
VITE_CHAT_URL=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Huellero — Reloj biométrico ZK
# IP y puerto del dispositivo en la LAN
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
HUELLERO_IP=192.168.1.254
HUELLERO_PORT=4370
MONGO_COLECCION=asistencia

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Red Docker — Subnet interna
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NETWORK_SUBNET=172.28.0.0/16
