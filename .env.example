# ═══════════════════════════════════════════════
# .env.example — Variables de entorno para Docker
# Copiar a .env y ajustar los valores
# ═══════════════════════════════════════════════

# ── Base de Datos MySQL ──
DB_USER=root
DB_PASSWORD=root_password_seguro
DB_NAME=erp

# ── JWT ──
SECRET_KEY=cambia_esta_llave_secreta_en_produccion_2024
ALGORITHM=HS256

# ── MongoDB ──
MONGO_DB_NAME=erp_nosql

# ── CORS (separar por coma) ──
CORS_ORIGINS=http://localhost,http://localhost:80,http://192.168.1.192

# ── URLs para el Frontend (build-time) ──
VITE_API_URL=http://localhost:8000
VITE_CHAT_URL=http://localhost:8001
